# Password for the single admin login at /admin
ADMIN_PASSWORD=choose-a-long-random-password

# Secret used to sign the login session (stateless JWT, no server session store).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-string

# Auto-added by Vercel when you connect a Blob store to this project.
# For local dev, copy it from Vercel → Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=
